# Replace these placeholders. For a local Node.js run, replace the host with 127.0.0.1.
DB=postgresql://CHANGE_ME:CHANGE_ME@host.docker.internal:5432/CHANGE_ME
TICKER=IMOEX
THRESHOLD=0.003
SLEEP_MS=60000

# Local Node.js settings; Compose overrides both inside the container.
HOST=127.0.0.1
PORT=3000
# PYTHON=C:\path\to\python.exe

# Host-only published port for Docker Compose; the container always uses 3000.
DOCKER_PORT=3000
