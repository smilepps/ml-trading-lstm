 {
  "name": "ml-trading",
  "version": "2.0.0",
  "description": "Многотаймфреймовый LSTM-прогноз движения цены по свечам MOEX: 300 base + 2×300 старших интервалов",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "tickers": "node tickers.js",
    "refresh-data": "node refresh_data.js",
    "refresh": "node refresh_data.js",
    "train:gpu": "node run_python.js train_gpu.py --threshold 0.003",
    "train:gpu:05": "node run_python.js train_gpu.py --threshold 0.005",
    "train:gpu:10": "node run_python.js train_gpu.py --threshold 0.010",
    "predict": "node predict.js",
    "confidence": "node run_python.js confidence_report_v4.py",
    "test": "node --test test"
  },
  "keywords": [
    "lstm",
    "onnx",
    "moex",
    "trading",
    "postgresql"
  ],
  "author": "Сергей Валерьевич Бессонов <dwsads@gmail.com> (https://t.me/smilepps)",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "onnxruntime-node": "^1.31.1",
    "pg": "^8.23.1"
  }
}
